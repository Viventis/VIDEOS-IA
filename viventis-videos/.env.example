# Copia este archivo como ".env" (en esta misma carpeta) y pon tu propia clave.
#   cp .env.example .env
# El archivo .env está en .gitignore: nunca se sube a GitHub.

# Obligatoria: tu API key de ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=pon_tu_api_key_aqui

# Opcional: ID de la voz (lista tus voces con: node tools/tts.mjs --list)
# ELEVENLABS_VOICE_ID=
# Opcional: modelo (por defecto eleven_multilingual_v2)
# ELEVENLABS_MODEL=eleven_v3
